package com.example.demo.controller;

@RestController
public class InfoController {

    @Value("${app.name}")
    private String appName;

    @Value("${app.version}")
    private String appVersion;

    @GetMapping("/api/info")
    public Map<String, String> getInfo() {
        return Map.of(
            "name", appName,
            "version", appVersion
        );
    }
}
