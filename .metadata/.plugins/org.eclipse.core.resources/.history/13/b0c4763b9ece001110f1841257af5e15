package com.example.demo.service;

import java.util.List;

import org.springframework.stereotype.Service;

import com.example.demo.dto.AuthorResponse;
import com.example.demo.dto.BookResponse;
import com.example.demo.dto.CreateAuthorRequest;
import com.example.demo.dto.CreateBookRequest;
import com.example.demo.dto.CreateMemberRequest;
import com.example.demo.dto.MemberResponse;
import com.example.demo.entities.Author;
import com.example.demo.entities.Book;
import com.example.demo.entities.Member;
import com.example.demo.exceptions.DuplicateResourceException;
import com.example.demo.exceptions.ResourceNotFoundException;
import com.example.demo.repo.AuthorRepository;
import com.example.demo.repo.BookRepository;
import com.example.demo.repo.MemberRepository;

import jakarta.validation.Valid;

@Service
public class LibraryManagementService {

	private final AuthorRepository libraryManagementRepository;
	private final BookRepository bookRepository;
	private final MemberRepository memberRepository;

	public LibraryManagementService(AuthorRepository libraryManagementRepository, BookRepository bookRepository,
			MemberRepository memberRepository) {
		this.libraryManagementRepository = libraryManagementRepository;
		this.bookRepository = bookRepository;
		this.memberRepository = memberRepository;
	}

	public AuthorResponse createAuthor(@Valid CreateAuthorRequest request) {

		if (request.getEmail() != null && libraryManagementRepository.existsByEmail(request.getEmail())) {
			throw new DuplicateResourceException("An author with this email already exists.");
		}

		Author author = new Author();
		author.setName(request.getName());
		author.setEmail(request.getEmail());

		Author savedAuthor = libraryManagementRepository.save(author);

		return new AuthorResponse(savedAuthor.getId(), savedAuthor.getName(), savedAuthor.getEmail());
	}

	public List<AuthorResponse> getAllAuthors() {

		return libraryManagementRepository.findAll().stream()
				.map(author -> new AuthorResponse(author.getId(), author.getName(), author.getEmail())).toList();
	}

	public AuthorResponse getAuthorById(Long id) {

		Author author = libraryManagementRepository.findById(id)
				.orElseThrow(() -> new ResourceNotFoundException("Author not found with ID: " + id));

		return new AuthorResponse(author.getId(), author.getName(), author.getEmail());
	}

	public AuthorResponse updateAuthor(Long id, @Valid CreateAuthorRequest request) {

		// 1. Check whether the author exists
		Author author = libraryManagementRepository.findById(id)
				.orElseThrow(() -> new ResourceNotFoundException("Author not found with ID: " + id));

		// 2. Update name only if provided
		if (request.getName() != null) {
			author.setName(request.getName());
		}

		// 3. Update email only if provided
		if (request.getEmail() != null) {

			// Check whether the email belongs to another author
			if (!request.getEmail().equals(author.getEmail())
					&& libraryManagementRepository.existsByEmail(request.getEmail())) {

				throw new DuplicateResourceException("Email already exists: " + request.getEmail());
			}

			author.setEmail(request.getEmail());
		}

		// 4. Save updated author
		Author updatedAuthor = libraryManagementRepository.save(author);

		// 5. Return response
		return new AuthorResponse(updatedAuthor.getId(), updatedAuthor.getName(), updatedAuthor.getEmail());
	}

	public BookResponse createNewBook(@Valid CreateBookRequest request) {

		// 1. Check whether ISBN already exists
		if (bookRepository.existsByIsbn(request.getIsbn())) {
			throw new DuplicateResourceException("Book with ISBN " + request.getIsbn() + " already exists");
		}

		// 2. Find the author
		Author author = libraryManagementRepository.findById(request.getAuthorId())
				.orElseThrow(() -> new ResourceNotFoundException("Author not found with ID: " + request.getAuthorId()));

		// 3. Convert DTO to entity
		Book book = new Book();
		book.setTitle(request.getTitle());
		book.setIsbn(request.getIsbn());
		Boolean available = request.getAvailable() != null ? request.getAvailable() : false;
		book.setAvailable(available);
		book.setAuthor(author);

		// 4. Save the book
		Book savedBook = bookRepository.save(book);

		// 5. Convert entity to response DTO
		return new BookResponse(savedBook.getId(), savedBook.getTitle(), savedBook.getIsbn(), savedBook.getAvailable(),
				savedBook.getAuthor().getId(), savedBook.getAuthor().getName());
	}

	public List<BookResponse> getAllBooks() {

		return bookRepository.findAll().stream().map(book -> new BookResponse(book.getId(), book.getTitle(),
				book.getIsbn(), book.getAvailable(), book.getAuthor().getId(), book.getAuthor().getName())).toList();
	}

	public BookResponse getBookById(Long id) {

		Book book = bookRepository.findById(id)
				.orElseThrow(() -> new ResourceNotFoundException("Book not found with ID: " + id));
		return new BookResponse(book.getId(), book.getTitle(), book.getIsbn(), book.getAvailable(),
				book.getAuthor().getId(), book.getAuthor().getName());

	}

	public BookResponse updateBook(Long id, @Valid CreateBookRequest request) {

		// 1. Find the existing book
		Book book = bookRepository.findById(id)
				.orElseThrow(() -> new ResourceNotFoundException("Book not found with ID: " + id));

		// 2. Update title only if provided
		if (request.getTitle() != null) {
			book.setTitle(request.getTitle());
		}

		// 3. Update ISBN only if provided
		if (request.getIsbn() != null) {
			book.setIsbn(request.getIsbn());
		}

		// 4. Update availability only if provided
		if (request.getAvailable() != null) {
			book.setAvailable(request.getAvailable());
		}

		// 5. Update author only if authorId is provided
		if (request.getAuthorId() != null) {

			Author author = libraryManagementRepository.findById(request.getAuthorId()).orElseThrow(
					() -> new ResourceNotFoundException("Author not found with ID: " + request.getAuthorId()));

			book.setAuthor(author);
		}

		// 6. Save the updated book
		Book updatedBook = bookRepository.save(book);

		// 7. Return response
		return new BookResponse(updatedBook.getId(), updatedBook.getTitle(), updatedBook.getIsbn(),
				updatedBook.getAvailable(), updatedBook.getAuthor().getId(), updatedBook.getAuthor().getName());
	}

	public BookResponse deletebook(Long id) {

		Book book = bookRepository.findById(id)
				.orElseThrow(() -> new ResourceNotFoundException("Book not found with ID: " + id));

		BookResponse response = new BookResponse(book.getId(), book.getTitle(), book.getIsbn(), book.getAvailable(),
				book.getAuthor().getId(), book.getAuthor().getName());

		bookRepository.delete(book);

		return response;
	}

	public MemberResponse createNewMember(@Valid CreateMemberRequest request) {

		if (request.getEmail() != null && memberRepository.existsByEmail(request.getEmail())) {
			throw new DuplicateResourceException("A Member with this email already exists.");
		}

		Member member = new Member();
		member.setName(request.getName());
		member.setEmail(request.getEmail());

		Member savedMember = memberRepository.save(member);

		return new MemberResponse(savedMember.getId(), savedMember.getName(), savedMember.getEmail(),
				savedMember.getPhone());

	}

	public List<MemberResponse> getAllMembers() {

		return memberRepository.findAll().stream().map(
				member -> new MemberResponse(member.getId(), member.getName(), member.getEmail(), member.getPhone()))
				.toList();
	}

