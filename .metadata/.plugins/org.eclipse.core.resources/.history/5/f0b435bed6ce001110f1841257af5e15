	// ==================== BORROW BOOK TESTS ====================

	@Test
	void borrowNewBook_Success() {
	    CreateBorrowRequest request = new CreateBorrowRequest();
	    request.setBookId(1L);
	    request.setMemberId(1L);

	    when(bookRepository.findById(1L)).thenReturn(Optional.of(book));
	    when(memberRepository.findById(1L)).thenReturn(Optional.of(member));

	    when(borrowBookRepository
	            .existsByMemberIdAndBookIdAndStatusIn(
	                    eq(1L), eq(1L), anyList()))
	            .thenReturn(false);

	    when(borrowBookRepository.countByMemberIdAndStatusIn(
	            eq(1L), anyList())).thenReturn(0L);

	    when(bookRepository.save(any(Book.class)))
	            .thenAnswer(invocation -> invocation.getArgument(0));

	    when(borrowBookRepository.save(any(BorrowRecord.class)))
	            .thenAnswer(invocation -> {
	                BorrowRecord saved = invocation.getArgument(0);
	                saved.setId(1L);
	                return saved;
	            });

	    BorrowResponse response = service.borrowNewBook(request);

	    assertNotNull(response);
	    assertEquals(1L, response.getBookId());
	    assertEquals(1L, response.getMemberId());
	    assertEquals(BorrowStatus.ACTIVE, response.getStatus());
	    assertEquals(LocalDate.now(), response.getBorrowedAt());
	    assertEquals(LocalDate.now().plusDays(14), response.getDueDate());
	    assertFalse(book.getAvailable());

	    verify(bookRepository).save(book);
	    verify(borrowBookRepository).save(any(BorrowRecord.class));
	}
