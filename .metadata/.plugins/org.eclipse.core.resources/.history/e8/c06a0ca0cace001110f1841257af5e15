			return new MemberResponse(updatedMember.getId(), updatedMember.getName(), updatedMember.getEmail(),
					updatedMember.getPhone());
		} catch (Exception e) {
			logger.error("Internal server error while processing the request");
			throw new RuntimeException("An unexpected error occurred.", e);
		}

	}

	@Transactional
	public BorrowResponse borrowNewBook(@Valid CreateBorrowRequest request) {

		try {
			Book book = bookRepository.findById(request.getBookId())
					.orElseThrow(() -> new ResourceNotFoundException("Book not found with ID: " + request.getBookId()));

			if (Boolean.TRUE.equals(book.getAvailable())) {
				throw new ResourceNotFoundException("The requested book is not avilable in the library");
			}

			Member member = memberRepository.findById(request.getMemberId()).orElseThrow(
					() -> new ResourceNotFoundException("Member not found with ID: " + request.getMemberId()));

			boolean alreadyBorrowed = borrowBookRepository.existsByMemberIdAndBookIdAndStatusIn(member.getId(),
					book.getId(), List.of(BorrowStatus.ACTIVE, BorrowStatus.OVERDUE));

			if (alreadyBorrowed) {
				throw new BookAlreadyBorrowedException(
						"This member has already borrowed this book and has not returned it yet.");
			}

			long currentBorrowCount = borrowBookRepository.countByMemberIdAndStatusIn(member.getId(),
					List.of(BorrowStatus.ACTIVE, BorrowStatus.OVERDUE));

			if (currentBorrowCount >= maxActiveBorrowsPerMember) {
				throw new BorrowLimitExceededException(
						"Member has reached the maximum limit of " + maxActiveBorrowsPerMember + " borrowed books.");
			}

			BorrowRecord br = new BorrowRecord();
			br.setBook(book);
			br.setMember(member);
			LocalDate borrowedAt = LocalDate.now();
			br.setBorrowedAt(borrowedAt);
			LocalDate dueDate = borrowedAt.plusDays(loanDays);
			br.setDueDate(dueDate);

			br.setReturnedAt(null);
			br.setStatus(BorrowStatus.ACTIVE);

			book.setAvailable(false);
			bookRepository.save(book);

			BorrowRecord savedRecord = borrowBookRepository.save(br);

			return new BorrowResponse(savedRecord.getId(), savedRecord.getBook().getId(),
					savedRecord.getBook().getTitle(), savedRecord.getMember().getId(),
					savedRecord.getMember().getName(), savedRecord.getBorrowedAt(), savedRecord.getDueDate(),
					savedRecord.getReturnedAt(), savedRecord.getStatus());
		} catch (Exception e) {
			logger.error("Internal server error while processing the request");
			throw new RuntimeException("An unexpected error occurred.", e);
		}
	}

	@Transactional
	public BorrowResponse returnBorrowedBook(Long id) {

		try {
			BorrowRecord br = borrowBookRepository.findById(id)
					.orElseThrow(() -> new ResourceNotFoundException("Borrow record not found with ID: " + id));

			if (br.getStatus() == BorrowStatus.RETURNED) {
				throw new BookAlreadyReturnedException("This book has already been returned");
			}

			br.setReturnedAt(LocalDate.now());
			br.setStatus(BorrowStatus.RETURNED);

			Book book = br.getBook();
			book.setAvailable(true);

			bookRepository.save(book);
			BorrowRecord updatedRecord = borrowBookRepository.save(br);

			return new BorrowResponse(updatedRecord.getId(), updatedRecord.getBook().getId(),
					updatedRecord.getBook().getTitle(), updatedRecord.getMember().getId(),
					updatedRecord.getMember().getName(), updatedRecord.getBorrowedAt(), updatedRecord.getDueDate(),
					updatedRecord.getReturnedAt(), updatedRecord.getStatus());
		} catch (Exception e) {
			logger.error("Internal server error while processing the request");
			throw new RuntimeException("An unexpected error occurred.", e);
		}
	}

	public List<BorrowResponse> getMemberBorrowHistory(Long memberId) {

		try {
			// 1. Check whether the member exists
			memberRepository.findById(memberId)
					.orElseThrow(() -> new ResourceNotFoundException("Member not found with ID: " + memberId));

			// 2. Fetch all borrow records for this member
			List<BorrowRecord> records = borrowBookRepository.findByMemberId(memberId);

			// 3. Convert entities to response DTOs
			return records.stream()
					.map(value -> new BorrowResponse(value.getId(), value.getBook().getId(),
							value.getBook().getTitle(), value.getMember().getId(), value.getMember().getName(),
							value.getBorrowedAt(), value.getDueDate(), value.getReturnedAt(), value.getStatus()))
					.toList();
		} catch (Exception e) {
			logger.error("Internal server error while processing the request");
			throw new RuntimeException("An unexpected error occurred.", e);
		}
	}

