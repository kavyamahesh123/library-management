    @Test
    void borrowNewBook_SameMemberAlreadyBorrowedBook() {
        CreateBorrowRequest request = new CreateBorrowRequest();
        request.setBookId(1L);
        request.setMemberId(1L);

        // The book is unavailable because it is already borrowed.
        book.setAvailable(false);

        when(bookRepository.findById(1L)).thenReturn(Optional.of(book));
        when(memberRepository.findById(1L)).thenReturn(Optional.of(member));

        // This check must happen before checking book availability.
        when(borrowBookRepository
                .existsByMemberIdAndBookIdAndStatusIn(
                        eq(1L), eq(1L), anyList()))
                .thenReturn(true);

        assertThrows(BookAlreadyBorrowedException.class,
                () -> service.borrowNewBook(request));

        // The availability check should stop the request only if the
        // member has not already borrowed this book.
        verify(borrowBookRepository, never())
                .countByMemberIdAndStatusIn(any(Long.class), anyList());

        verify(bookRepository, never()).save(any(Book.class));
        verify(borrowBookRepository, never()).save(any(BorrowRecord.class));
    }

